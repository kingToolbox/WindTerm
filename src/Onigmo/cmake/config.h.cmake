/* config.h generated by CMake for the WindTerm build of Onigmo.
 *
 * Onigmo's regint.h includes "config.h" unconditionally, so this file has to
 * exist even when the autoconf machinery is not used.
 */

#ifndef ONIGMO_CMAKE_CONFIG_H
#define ONIGMO_CMAKE_CONFIG_H

#cmakedefine HAVE_ALLOCA_H 1
#cmakedefine HAVE_DLFCN_H 1
#cmakedefine HAVE_INTTYPES_H 1
#cmakedefine HAVE_MEMORY_H 1
#cmakedefine HAVE_STDINT_H 1
#cmakedefine HAVE_STDLIB_H 1
#cmakedefine HAVE_STRINGS_H 1
#cmakedefine HAVE_STRING_H 1
#cmakedefine HAVE_SYS_STAT_H 1
#cmakedefine HAVE_SYS_TIMES_H 1
#cmakedefine HAVE_SYS_TIME_H 1
#cmakedefine HAVE_SYS_TYPES_H 1
#cmakedefine HAVE_UNISTD_H 1

#cmakedefine HAVE_ALLOCA 1
#cmakedefine STDC_HEADERS 1
#cmakedefine TIME_WITH_SYS_TIME 1

#define HAVE_PROTOTYPES 1
#define HAVE_STDARG_PROTOTYPES 1

#define SIZEOF_INT   @SIZEOF_INT@
#define SIZEOF_SHORT @SIZEOF_SHORT@
#define SIZEOF_LONG  @SIZEOF_LONG@

/* The stack grows downwards on every architecture WindTerm targets
 * (x86_64, arm64). */
#define STACK_DIRECTION @STACK_DIRECTION@

#define PACKAGE         "onigmo"
#define PACKAGE_NAME    "Onigmo"
#define PACKAGE_TARNAME "onigmo"
#define PACKAGE_VERSION "@ONIGMO_VERSION@"
#define PACKAGE_STRING  "Onigmo @ONIGMO_VERSION@"
#define PACKAGE_BUGREPORT ""
#define PACKAGE_URL     ""
#define VERSION         "@ONIGMO_VERSION@"

#cmakedefine USE_COMBINATION_EXPLOSION_CHECK 1
#cmakedefine USE_CRNL_AS_LINE_TERMINATOR 1

#endif /* ONIGMO_CMAKE_CONFIG_H */
